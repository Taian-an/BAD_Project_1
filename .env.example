# --- Local dev only. In production every value below is fetched from Azure
# Key Vault at startup instead (proposal §7) — set KEY_VAULT_URL to switch. ---

PORT=4002
BASE_PATH=/campus-store
NODE_ENV=development

# Set to "mock" to use POST /auth/dev-login instead of real Azure AD (useful
# before the Azure AD app registration exists — see proposal Wk1/Wk3).
AUTH_MODE=mock

DATABASE_URL="mysql://campus_store_user:campus_store_pass@127.0.0.1:3307/campus_store"
JWT_SECRET=dev_jwt_secret_change_me

# --- Azure AD (real login, AUTH_MODE=azuread) ---
AD_TENANT_ID=
AD_CLIENT_ID=
AD_CLIENT_SECRET=
AD_REDIRECT_URI=http://localhost:4002/campus-store/auth/callback
AD_STAFF_GROUP_ID=

# Where /auth/callback sends the browser back to after a successful Azure AD
# login, with the JWT in the URL fragment (#token=...).
FRONTEND_URL=http://localhost:5173

# --- Azure Key Vault (production only; leave unset for local dev) ---
KEY_VAULT_URL=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- AI description generation ---
AI_PROVIDER=openai
AI_API_KEY=

# --- Peer service-to-service API ---
# Set PEER_MOCK=true to always approve discounts locally before a partner is
# confirmed (proposal §13).
PEER_MOCK=true
PEER_PARTNER_BASE_URL=
PEER_KEY_IN=
