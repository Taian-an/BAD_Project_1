generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  STAFF
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
}

model User {
  id          Int      @id @default(autoincrement())
  adObjectId  String   @unique
  email       String   @unique
  displayName String
  role        Role     @default(STUDENT)
  department  String?
  createdAt   DateTime @default(now())

  orders   Order[]
  products Product[] @relation("ProductAuthor")
}

model Category {
  id          Int     @id @default(autoincrement())
  name        String  @db.VarChar(100)
  description String? @db.VarChar(255)

  products Product[]
}

model Product {
  id            Int      @id @default(autoincrement())
  name          String   @db.VarChar(150)
  basePrice     Decimal  @db.Decimal(10, 2)
  stockQty      Int      @default(0)
  imageUrl      String?
  description   String?  @db.Text
  aiDescription String?  @db.Text
  // Ties a product to a department for the peer discount check (proposal
  // §9.2's "CS jacket") — null means no department discount applies to it.
  discountDepartment String?  @db.VarChar(100)
  categoryId    Int
  createdById   Int
  createdAt     DateTime @default(now())

  category   Category    @relation(fields: [categoryId], references: [id])
  createdBy  User        @relation("ProductAuthor", fields: [createdById], references: [id])
  orderItems OrderItem[]
}

model Order {
  id              Int         @id @default(autoincrement())
  userId          Int
  status          OrderStatus @default(PENDING)
  totalAmount     Decimal     @default(0.00) @db.Decimal(10, 2)
  discountApplied Boolean     @default(false)
  createdAt       DateTime    @default(now())

  user  User        @relation(fields: [userId], references: [id])
  items OrderItem[]
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

// Keys we hand out to a partner team for our "expose" endpoint (§9.1)
model PeerApiKeyIssued {
  id          Int      @id @default(autoincrement())
  partnerName String
  keyHash     String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// The partner's key we use to call their API (§9.2) — no FK, external reference
model PeerApiKeyConsumed {
  id          Int    @id @default(autoincrement())
  partnerName String
  baseUrl     String
  keyRef      String
  purpose     String?
}
